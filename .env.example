# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# Fyers API app (from myapi.fyers.in)
FYERS_APP_ID=YOUR_APP_ID-100
FYERS_SECRET=YOUR_SECRET
FYERS_REDIRECT_URI=http://127.0.0.1:5000/fyers/callback

# --- TOTP auto-login (OPTIONAL — leave all three blank to keep using the
# manual `python auth.py` browser login every morning). Setting all three
# lets run.py refresh a stale token.json on its own. As sensitive as a
# password — never commit this file. See auth.py's module docstring for what
# this trades off (it replays Fyers's internal web-login endpoints, not a
# documented API) before you turn it on.
FYERS_ID=                  # your Fyers CLIENT ID / login id (e.g. XY01234), NOT the app id above
FYERS_TOTP_SECRET=         # the TOTP secret shown when you enabled 2FA in your Fyers profile
FYERS_PIN=                 # your 4-digit Fyers trading PIN

# Bot config
MODE=paper            # paper (simulated) | live (real orders — needs CONFIRM_LIVE=YES)
CONFIRM_LIVE=NO       # safety guard; set YES only to trade real money
POLL_SEC=30           # seconds between cycles
NEAR_PCT=1.0          # arm a buy-stop within this % of the rim
ALERTS=true
MAX_POSITIONS=0        # 0 = unlimited; cap concurrent open positions (start small, e.g. 1, for a first live test)
ORDER_TAG=cup          # Fyers orderTag / Algo-ID — keep <=20 chars, used to recognise our own orders
ALLOW_T2T=false        # T2T ("BE"-series) stocks can't take a same-day SL-M fill — skipped from the watchlist unless true

# Telegram (optional; blank = alerts print to console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
